# Copy to .env.local for local development. Leave a value empty to turn that feature off.
# Google Apps Script web app URL for the quote form (see README.md → "Quote form"). Empty → the form opens the visitor's email app.
NEXT_PUBLIC_SHEETS_ENDPOINT=
# Cloudflare Turnstile site key. 1x00000000000000000000AA is Cloudflare's always-pass test key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
