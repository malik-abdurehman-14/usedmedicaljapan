# Public build settings for the live site (these values end up in the browser, so they are not secrets).
# Google Apps Script web app that receives the quote form (see README.md → "Quote form").
NEXT_PUBLIC_SHEETS_ENDPOINT=https://script.google.com/macros/s/AKfycby2ImvZQ3lmUyTgOu17V9qHYoEA85Z04JGarfS05PucbjptzcgZtvOHOIXtn0B7cZch/exec
# Cloudflare Turnstile site key (CAPTCHA). Leave empty to turn the CAPTCHA off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
